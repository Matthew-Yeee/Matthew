{
  "mcpServers": {
    "garmin": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/BorisBW/garmin-mcp-cn",
        "garmin-mcp"
      ],
      "env": {
        "GARMIN_EMAIL": "${GARMIN_EMAIL}",
        "GARMIN_PASSWORD": "${GARMIN_PASSWORD}",
        "GARMIN_IS_CN": "true"
      }
    }
  }
}
